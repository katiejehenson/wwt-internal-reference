      el.setAttribute('data-hide', current === 'all' || p === 'all' || p === current ? '0' : '1');
    });
  }
  document.querySelectorAll('.paths button').forEach(function (b) {
    b.addEventListener('click', function () {
      current = b.dataset.path;
      document.querySelectorAll('.paths button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      applyPath();
    });
  });
  document.querySelector('.toolbar').addEventListener('click', function (ev) {
    var act = ev.target.getAttribute('data-act'); if (!act) return;
    document.querySelectorAll('#stages > details').forEach(function (d) { d.open = act === 'open'; });
  });
  function openTarget() {
    var el = location.hash && document.getElementById(location.hash.slice(1));
    if (el && el.tagName === 'DETAILS') { el.open = true; el.scrollIntoView({ block: 'start' }); }
  }
  window.addEventListener('hashchange', openTarget); openTarget();
  window.addEventListener('beforeprint', function () { document.querySelectorAll('details').forEach(function (d) { d.open = true; }); });
