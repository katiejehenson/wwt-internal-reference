<title>Trip Lifecycle SOP — Weindling World Travel</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Jost:wght@300;400;500;600&display=swap');
  :root {
    --navy:#1a2744; --gold:#b8964e; --cream:#fdfaf5; --sand:#f0ebe0; --text:#2c2c2c; --muted:#7a7e85; --border:#ddd6cc; --white:#ffffff;
    --green-bg:#e6f2ea; --green:#2f6b44; --flag-bg:#fbf3e2;
    --t-custom:#e8edf6; --t-hotel:#f3ece0; --t-cruise:#e3f0f1; --t-all:#efefef;
  }
  *, *::before, *::after { box-sizing:border-box; margin:0; padding:0; }
  body { font-family:'Jost',sans-serif; background:var(--cream); color:var(--text); line-height:1.55; }
  a { color:var(--navy); }
  header { background:var(--navy); color:var(--white); padding:48px 24px 44px; text-align:center; position:relative; overflow:hidden; }
  header::before { content:''; position:absolute; inset:0; background:repeating-linear-gradient(-45deg,transparent,transparent 50px,rgba(255,255,255,.02) 50px,rgba(255,255,255,.02) 100px); }
  .header-inner { position:relative; }
  .logo-area { display:flex; align-items:center; justify-content:center; gap:16px; margin-bottom:24px; }
  .logo-symbol { width:48px; height:48px; border:2px solid var(--gold); border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:'Cormorant Garamond',serif; font-size:22px; color:var(--gold); }
  .logo-text { text-align:left; }
  .logo-text .brand { font-family:'Cormorant Garamond',serif; font-size:1.5rem; font-weight:600; line-height:1; }
  .logo-text .sub { font-size:11px; color:rgba(255,255,255,.5); letter-spacing:2px; text-transform:uppercase; }
  header h1 { font-family:'Cormorant Garamond',serif; font-size:2.6rem; font-weight:400; line-height:1.15; margin-bottom:12px; }
  header h1 em { color:var(--gold); font-style:italic; }
  header p { color:rgba(255,255,255,.6); font-size:14.5px; max-width:580px; margin:0 auto; line-height:1.7; }
  main { max-width:1000px; margin:0 auto; padding:36px 24px 80px; }
  .nav { display:flex; gap:18px; flex-wrap:wrap; font-size:12.5px; }
  .nav a { text-decoration:none; color:var(--muted); } .nav a:hover { color:var(--gold); }
  .section-label { font-size:10px; font-weight:600; letter-spacing:3px; text-transform:uppercase; color:var(--gold); margin:40px 0 10px; display:block; }
  h2 { font-family:'Cormorant Garamond',serif; font-size:1.7rem; font-weight:600; color:var(--navy); margin-bottom:6px; }
  .lead { font-size:13.5px; color:var(--muted); max-width:72ch; margin-bottom:14px; }

  .journey { display:grid; grid-template-columns:repeat(7,1fr); gap:0; background:var(--white); border:1px solid var(--border); border-radius:8px; overflow:hidden; }
  .journey a { text-decoration:none; padding:14px 10px; border-left:1px solid var(--border); text-align:center; font-size:12px; color:var(--navy); position:relative; }
  .journey a:first-child { border-left:0; }
  .journey a:hover { background:var(--sand); }
  .journey .num { display:grid; margin:0 auto 6px; }
  .journey small { display:block; color:var(--muted); font-size:10.5px; margin-top:2px; }
  @media (max-width:760px) { .journey { grid-template-columns:repeat(4,1fr); } .journey a:nth-child(5) { border-left:0; } .journey a:nth-child(n+5) { border-top:1px solid var(--border); } }

  .paths { display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin:18px 0 6px; }
  .paths span { font-size:12px; color:var(--muted); margin-right:4px; }
  .paths button, .toolbar button { font:500 12.5px 'Jost',sans-serif; color:var(--navy); background:var(--white); border:1px solid var(--border); border-radius:20px; padding:5px 14px; cursor:pointer; }
  .paths button[aria-pressed="true"] { background:var(--navy); color:var(--white); border-color:var(--navy); }
  .toolbar { display:flex; gap:8px; margin:10px 0 12px; } .toolbar button { border-radius:6px; }
  .paths button:hover, .toolbar button:hover { border-color:var(--gold); }

  details { background:var(--white); border:1px solid var(--border); border-radius:8px; margin-bottom:10px; overflow:hidden; scroll-margin-top:16px; }
  details[open] { box-shadow:0 6px 24px rgba(0,0,0,.06); }
  summary { list-style:none; cursor:pointer; display:flex; align-items:center; gap:12px; padding:15px 18px; }
  summary::-webkit-details-marker { display:none; }
  summary::after { content:'+'; margin-left:auto; color:var(--gold); font-weight:600; font-size:20px; line-height:1; }
  details[open] > summary::after { content:'–'; }
  details[open] > summary { border-bottom:1px solid var(--border); background:var(--sand); }
  summary:focus-visible { outline:2px solid var(--gold); outline-offset:-2px; }
  .num { display:inline-grid; place-items:center; width:26px; height:26px; border-radius:50%; background:var(--navy); color:var(--gold); font-size:12.5px; font-weight:600; flex-shrink:0; }
  .st { font-family:'Cormorant Garamond',serif; font-size:1.25rem; font-weight:600; color:var(--navy); }
  .sbody { padding:6px 20px 18px; }
  .block { padding-top:16px; }
  .block h4 { font-size:10px; font-weight:600; letter-spacing:2px; text-transform:uppercase; color:var(--gold); margin-bottom:8px; }
  .block p { font-size:13.5px; max-width:80ch; }
  .block.flag { background:var(--flag-bg); border-left:3px solid var(--gold); padding:12px 16px; margin-top:16px; border-radius:0 6px 6px 0; }
  ol.steps { padding-left:20px; font-size:13.5px; display:grid; gap:6px; }
  ol.steps li { padding-left:4px; }
  ul.check, ul.tl { list-style:none; display:grid; gap:4px; font-size:13px; }
  ul.check li, ul.tl li, ol.steps li { display:flex; justify-content:space-between; align-items:flex-start; gap:10px; }
  ol.steps li { display:list-item; }
  ol.steps li .tag { float:right; margin-left:10px; }
  ul.check li, ul.tl li { padding:6px 8px; border-bottom:1px solid var(--sand); }
  ul.check label { display:flex; gap:8px; align-items:flex-start; cursor:pointer; }
  ul.check input { margin-top:4px; accent-color:var(--gold); }
  ul.check input:checked + span { text-decoration:line-through; color:var(--muted); }
  ul.plain { padding-left:18px; font-size:13px; display:grid; gap:4px; }
  .sub { font-size:11.5px; color:var(--muted); font-weight:400; }
  .tag { flex-shrink:0; font-size:10px; font-weight:600; letter-spacing:.5px; padding:2px 8px; border-radius:20px; color:var(--navy); white-space:nowrap; }
  .tag.custom { background:var(--t-custom); } .tag.hotel { background:var(--t-hotel); } .tag.cruise { background:var(--t-cruise); } .tag.all { background:var(--t-all); color:var(--muted); }
  .tw { overflow-x:auto; }
  table { width:100%; border-collapse:collapse; font-size:12.5px; }
  th { text-align:left; font-size:10px; font-weight:600; letter-spacing:1.5px; text-transform:uppercase; color:var(--gold); padding:7px 8px; border-bottom:1px solid var(--border); }
  td { padding:7px 8px; border-bottom:1px solid var(--sand); vertical-align:top; }
  td.when { white-space:nowrap; font-variant-numeric:tabular-nums; }
  td.wfc { font-size:12px; color:var(--muted); min-width:190px; }
  tr.is-off td:nth-child(2) { color:var(--muted); }
  .pill { display:inline-block; font-size:10.5px; font-weight:500; padding:1px 7px; border-radius:20px; }
  .pill.on { background:var(--green-bg); color:var(--green); } .pill.off { color:var(--muted); border:1px dashed var(--border); }
  [data-hide="1"] { display:none !important; }

  .rules { background:var(--white); border:1px solid var(--border); border-radius:8px; padding:22px 26px; margin-top:36px; }
  .rules h3 { font-family:'Cormorant Garamond',serif; font-size:1.2rem; font-weight:600; color:var(--navy); margin-bottom:12px; padding-bottom:8px; border-bottom:1px solid var(--border); }
  .rules ul { list-style:none; display:grid; grid-template-columns:1fr 1fr; gap:8px 24px; }
  @media (max-width:600px) { .rules ul { grid-template-columns:1fr; } header h1 { font-size:2rem; } }
  .rules li { font-size:13px; display:flex; gap:8px; } .rules li::before { content:'—'; color:var(--gold); font-weight:600; }
  footer { border-top:1px solid var(--border); padding:20px 40px; text-align:center; font-size:12px; color:var(--muted); }
  footer a { color:var(--gold); text-decoration:none; }
  @media print {
    details > *:not(summary) { display:block !important; }
    .paths, .toolbar, .nav { display:none; } summary::after { display:none; }
    details { break-inside:auto; box-shadow:none; } .block { break-inside:avoid; }
    body { -webkit-print-color-adjust:exact; print-color-adjust:exact; }
  }
</style>
