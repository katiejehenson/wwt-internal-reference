<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tern Library Catalog — Weindling World Travel</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Jost:wght@300;400;500;600&display=swap');

  :root {
    --navy:  #1a2744;
    --gold:  #b8964e;
    --cream: #fdfaf5;
    --sand:  #f0ebe0;
    --text:  #2c2c2c;
    --muted: #7a7e85;
    --border:#ddd6cc;
    --white: #ffffff;
    --green-bg:#e6f2ea; --green:#2f6b44;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Jost', sans-serif; background: var(--cream); color: var(--text); line-height: 1.55; }
  a { color: var(--navy); }

  /* ── HEADER (matches the Operations Hub) ── */
  header { background: var(--navy); color: var(--white); padding: 48px 24px 44px; text-align: center; position: relative; overflow: hidden; }
  header::before { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(-45deg, transparent, transparent 50px, rgba(255,255,255,.02) 50px, rgba(255,255,255,.02) 100px); }
  .header-inner { position: relative; }
  .logo-area { display: flex; align-items: center; justify-content: center; gap: 16px; margin-bottom: 24px; }
  .logo-symbol { width: 48px; height: 48px; border: 2px solid var(--gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: 'Cormorant Garamond', serif; font-size: 22px; color: var(--gold); }
  .logo-text { text-align: left; }
  .logo-text .brand { font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; font-weight: 600; line-height: 1; }
  .logo-text .sub { font-size: 11px; color: rgba(255,255,255,.5); letter-spacing: 2px; text-transform: uppercase; }
  header h1 { font-family: 'Cormorant Garamond', serif; font-size: 2.6rem; font-weight: 400; line-height: 1.15; margin-bottom: 12px; }
  header h1 em { color: var(--gold); font-style: italic; }
  header p { color: rgba(255,255,255,.6); font-size: 14.5px; max-width: 560px; margin: 0 auto; line-height: 1.7; }
  .back { position: absolute; left: 0; top: -28px; color: rgba(255,255,255,.6); font-size: 12px; text-decoration: none; letter-spacing: 1px; }
  .back:hover { color: var(--gold); }

  main { max-width: 1040px; margin: 0 auto; padding: 44px 24px 80px; }
  .section-label { font-size: 10px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--gold); margin: 48px 0 8px; display: block; }
  h2 { font-family: 'Cormorant Garamond', serif; font-size: 1.7rem; font-weight: 600; color: var(--navy); margin-bottom: 6px; }
  .lead { font-size: 13.5px; color: var(--muted); max-width: 70ch; margin-bottom: 16px; }
  .toolbar { display: flex; gap: 8px; margin-bottom: 12px; }
  .toolbar button { font: 500 12px 'Jost', sans-serif; color: var(--navy); background: var(--white); border: 1px solid var(--border); border-radius: 6px; padding: 5px 12px; cursor: pointer; }
  .toolbar button:hover { border-color: var(--gold); }

  /* ── METRICS ── */
  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
  .metric { background: var(--white); border: 1px solid var(--border); border-radius: 8px; padding: 16px 18px; }
  .metric .n { font-family: 'Cormorant Garamond', serif; font-size: 2.4rem; font-weight: 600; color: var(--gold); line-height: 1; }
  .metric .l { font-weight: 600; color: var(--navy); margin-top: 4px; }
  .metric .s { font-size: 12px; color: var(--muted); }
  .legend { font-size: 12.5px; color: var(--muted); margin-top: 14px; display: flex; flex-wrap: wrap; gap: 6px 18px; }

  /* ── COLLAPSIBLES ── */
  details { background: var(--white); border: 1px solid var(--border); border-radius: 8px; margin-bottom: 10px; overflow: hidden; }
  details[open] { box-shadow: 0 6px 24px rgba(0,0,0,.06); }
  summary { list-style: none; cursor: pointer; display: flex; align-items: center; flex-wrap: wrap; gap: 6px 12px; padding: 14px 18px; }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: '+'; color: var(--gold); font-weight: 600; font-size: 18px; width: 14px; line-height: 1; }
  details[open] > summary::before { content: '–'; }
  details[open] > summary { border-bottom: 1px solid var(--border); background: var(--sand); }
  summary:hover .st { color: var(--gold); }
  summary:focus-visible { outline: 2px solid var(--gold); outline-offset: -2px; }
  .st { font-family: 'Cormorant Garamond', serif; font-size: 1.15rem; font-weight: 600; color: var(--navy); }
  .num { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--navy); color: var(--gold); font-size: 12px; font-weight: 600; }
  .cnt { margin-left: auto; font-size: 12px; color: var(--muted); }
  .badge { font-size: 10px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: var(--muted); border: 1px solid var(--border); border-radius: 20px; padding: 2px 8px; }
  .badge.on { color: var(--green); border-color: #b9d8c3; background: var(--green-bg); }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 22px; padding: 12px 18px 0; font-size: 12.5px; color: var(--muted); }
  .meta b { color: var(--navy); font-weight: 600; margin-right: 4px; }
  .empty { padding: 14px 18px; font-size: 13px; color: var(--muted); font-style: italic; }

  /* ── TABLES ── */
  .tw { overflow-x: auto; padding: 6px 8px 10px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th { text-align: left; font-size: 10px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: var(--gold); padding: 8px 10px; border-bottom: 1px solid var(--border); }
  td { padding: 7px 10px; border-bottom: 1px solid var(--sand); vertical-align: top; }
  tr:last-child td { border-bottom: 0; }
  tr:target { background: #fbf3e2; }
  tr.is-off td { color: var(--muted); }
  td.nm { font-weight: 500; color: var(--navy); min-width: 200px; }
  td.when { white-space: nowrap; font-variant-numeric: tabular-nums; }
  td.ic, td.typ { white-space: nowrap; }
  td a { text-decoration: none; } td a:hover { color: var(--gold); }
  td.wfn, td.sent { font-size: 12px; color: var(--muted); }
  .sub { font-size: 11.5px; color: var(--muted); }
  .pill { display: inline-block; font-size: 11px; font-weight: 500; padding: 2px 9px; border-radius: 20px; white-space: nowrap; }
  .pill.on { background: var(--green-bg); color: var(--green); }
  .pill.off { background: var(--white); color: var(--muted); border: 1px dashed var(--border); }
  .pill.task { background: var(--sand); color: var(--navy); }

  .fbody { padding: 14px 18px 16px; font-size: 13.5px; }
  .fbody p { margin-bottom: 10px; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 600px) { .cols { grid-template-columns: 1fr; } header h1 { font-size: 2rem; } }
  .fbody h4 { font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--gold); margin-bottom: 4px; }
  .fbody ul { padding-left: 18px; font-size: 13px; }

  .notes { background: var(--white); border: 1px solid var(--border); border-radius: 8px; padding: 24px 28px; }
  .notes ul { list-style: none; display: grid; gap: 10px; }
  .notes li { font-size: 13.5px; display: flex; gap: 8px; }
  .notes li::before { content: '—'; color: var(--gold); font-weight: 600; flex-shrink: 0; }
  .notes li b { color: var(--navy); margin-right: 4px; }
  .take { margin-top: 20px; background: var(--navy); color: rgba(255,255,255,.85); border-radius: 8px; padding: 24px 28px; font-size: 14px; line-height: 1.7; }
  .take h3 { font-family: 'Cormorant Garamond', serif; color: var(--gold); font-size: 1.3rem; font-weight: 600; margin-bottom: 6px; }

  footer { border-top: 1px solid var(--border); padding: 20px 40px; text-align: center; font-size: 12px; color: var(--muted); }
  footer a { color: var(--gold); text-decoration: none; }

  @media print {
    details > *:not(summary) { display: block !important; }
    details { break-inside: avoid; box-shadow: none; }
    summary::before, .toolbar, .back { display: none; }
    body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>
</head>
